<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.keel</groupId>
        <artifactId>keel-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>keel-spring-boot-starter</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-model-spring-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          接入适配层（KeelAgentClient / PrincipalResolver）：非 optional ——
          「接入便利」正是 starter 的核心价值，业务加依赖就该拿到简化入口。
          本模块只依赖 keel-core（+ optional 的 spring-web），不引入额外三方负担。
        -->
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-skill</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- graph 模式装配 GraphKeelAgent 与各 SPI 端口类型 -->
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-graph</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-guard</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          RAG 检索适配（FR-15/FR-17）：optional 保证 starter 不强制传递
          langchain4j；只有业务侧同时引入 keel-rag-langchain4j（或自研 EmbeddingModel）时
          自动配置才生效。装配类里已用 @ConditionalOnClass 双保险。
        -->
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-rag-langchain4j</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- 编译期需要 langchain4j 类型（EmbeddingModel/EmbeddingStore 条件判断），
             运行期由业务侧自己提供实现；同样 optional 不污染下游依赖树 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          MCP 只读 ToolPort 适配（FR-31）与官方 SDK：optional 保证不强制传递；
          业务侧引入 keel-mcp + mcp SDK（或自定义 McpSyncClient bean）时自动配置生效。
        -->
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-mcp</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          L1 Redis Checkpoint（FR-12）：optional 保证不强制传递 lettuce；
          业务侧引入 keel-memory 时自动配置生效。
        -->
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-memory</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!--
          Langfuse Trace（FR-70）：optional，仅 classpath 出现 keel-langfuse 时装配；
          未配置密钥时不创建 TracePort。
        -->
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-langfuse</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-harness</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!--
            NFR-04 启动自检 warn 模式需要日志输出：仓库 main 源码此前零日志依赖，
            这里只引 slf4j-api（版本由 spring-boot-starter-parent 管理，业务运行期
            自带 logback 等 binding），不引入任何具体日志实现。
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
