<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.keel</groupId>
        <artifactId>keel-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ticket-assist</artifactId>

    <dependencies>
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 示例对外暴露 HTTP 接口（FR-80）；内核不依赖 Web，仅 examples 使用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            FR-73：e2e 回归用 harness 的评测数据集加载 + checker（EvalCaseLoader /
            KeelEvalChecker / KeelEvalExtension）。仅 test scope——示例运行期不依赖评测套件。
        -->
        <dependency>
            <groupId>io.keel</groupId>
            <artifactId>keel-harness</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 让 README 的 mvn spring-boot:run / java -jar 真实可用（repackage 生成可执行 fat jar） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
